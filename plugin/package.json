{
  "name": "@local/dsh-code-animation",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "341 种代码动画风格：检索风格、写出动画、在对话里预览并导出视频。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "data.js",
    "tools.js",
    "client.js",
    "cordis.patch.yml",
    "styles.json",
    "stills",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
